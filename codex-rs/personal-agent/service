#!/bin/bash
# Personal Agent Service Manager
# Start/stop services for the agent

set -e

AGENT_DIR="/home/crispycreations/.codex/codex/codex-rs/personal-agent"
AGENT_HOME="${AGENT_HOME:-$HOME/.agent}"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

start() {
    echo -e "${YELLOW}Starting Personal Agent services...${NC}\n"
    
    # Check Ollama
    if ! curl -s http://localhost:11434/api/version > /dev/null 2>&1; then
        echo -e "${RED}✗${NC} Ollama not running"
        echo "  Start with: ollama serve"
        return 1
    fi
    echo -e "${GREEN}✓${NC} Ollama: OK"
    
    # Check Qdrant
    if ! curl -s http://localhost:6333/health > /dev/null 2>&1; then
        echo -e "${RED}✗${NC} Qdrant not running"
        echo "  Start with: docker run -d -p 6333:6333 qdrant/qdrant"
        return 1
    fi
    echo -e "${GREEN}✓${NC} Qdrant: OK"
    
    echo ""
    echo -e "${GREEN}✓${NC} All services ready!"
    echo -e "\nStart chatting:"
    echo "  agent              # Interactive chat"
    echo "  agent-menu         # Launcher menu"
    echo "  agent query 'hi'   # Single question"
    echo ""
}

stop() {
    echo -e "${YELLOW}Stopping services...${NC}"
    pkill -f "ollama serve" 2>/dev/null && echo "Ollama stopped" || echo "Ollama not running"
    docker stop $(docker ps -q -f "ancestor=qdrant/qdrant") 2>/dev/null && echo "Qdrant stopped" || echo "Qdrant not running"
    echo -e "${GREEN}✓${NC} Services stopped"
}

status() {
    echo -e "${YELLOW}Service Status:${NC}\n"
    
    if curl -s http://localhost:11434/api/version > /dev/null 2>&1; then
        version=$(curl -s http://localhost:11434/api/version | jq -r '.version' 2>/dev/null || echo "unknown")
        echo -e "${GREEN}✓${NC} Ollama: Running (v$version)"
    else
        echo -e "${RED}✗${NC} Ollama: Not responding"
    fi
    
    if curl -s http://localhost:6333/health > /dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} Qdrant: Running"
    else
        echo -e "${RED}✗${NC} Qdrant: Not responding"
    fi
    
    if [ -d "$AGENT_HOME" ]; then
        echo -e "${GREEN}✓${NC} Agent home: $AGENT_HOME"
    fi
    
    if [ -f "$AGENT_HOME/session.log" ]; then
        lines=$(wc -l < "$AGENT_HOME/session.log")
        echo -e "${GREEN}✓${NC} Chat history: $lines entries"
    fi
}

restart() {
    stop
    sleep 2
    start
}

case "${1:-status}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) restart ;;
    *)
        echo "Personal Agent Service Manager"
        echo ""
        echo "Usage: agent-service <command>"
        echo "Commands:"
        echo "  start    - Start Ollama and Qdrant"
        echo "  stop     - Stop services"
        echo "  status   - Show service status (default)"
        echo "  restart  - Restart services"
        ;;
esac
