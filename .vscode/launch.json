{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Run codex-tui",
      "cargo": {
        "cwd": "${workspaceFolder}/codex-rs",
        "args": [
          "run",
          "--bin=codex-tui",
          "--release"
        ]
      },
      "args": [],
      "console": "integratedTerminal"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug codex-tui",
      "cargo": {
        "cwd": "${workspaceFolder}/codex-rs",
        "args": [
          "run",
          "--bin=codex-tui"
        ]
      },
      "args": [],
      "console": "integratedTerminal",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach to running codex-tui",
      "pid": "${command:pickProcess}",
      "sourceLanguages": ["rust"]
    },
    {
      "command": "npm start",
      "name": "Run npm start (Node)",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Personal Agent",
      "type": "node-terminal",
      "request": "launch",
      "command": "/bin/bash ${workspaceFolder}/codex-rs/personal-agent/launch-app",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "docker",
      "name": "Docker: Attach .NET",
      "request": "attach",
      "platform": "netCore",
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      }
    }
  ]
}
